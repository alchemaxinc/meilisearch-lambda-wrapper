# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it with a real
# meilisearch_master_key or other secrets.
service_name           = "my-synchronous-meilisearch-service"
environment            = "development"
git_sha                = "abc123def"
ecr_repository_name    = "my-synchronous-meilisearch-service-api"
meilisearch_master_key = "CHANGE-ME-generate-a-real-secret-key"
